# JurisAI Bharat — Environment Variables
# Copy this file to .env and put your real credentials below:

GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile
PORT=3000

# Web search provider (api.langsearch.com — free tier available)
LANGSEARCH_API_KEY=YOUR_LANGSEARCH_API_KEY_HERE

# Optional fallback provider (OpenAI-compatible NIM endpoint)
NVIDIA_NIM_API_KEY=YOUR_NVIDIA_NIM_API_KEY_HERE
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
